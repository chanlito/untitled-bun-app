# `bun run setup` copies this to .env.local (gitignored) and fills in anything generated.
# Never put real secrets in this file: it is committed.

# API
PORT=3141
API_URL=http://localhost:3141
APP_URL=http://localhost:3142
DATABASE_URL=postgres://app:app@localhost:3143/app
# BETTER_AUTH_SECRET is generated into .env.local by `bun run setup`
# In production API_URL, APP_URL and DATABASE_URL must be set: there are no defaults there

# Logs: debug | info | warn | error | silent (default info), json | pretty (default json
# in production, pretty elsewhere)
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# Reverse proxies you control in front of the API: a load balancer or PaaS router is 1.
# At 0, X-Forwarded-For is ignored and the client IP is the socket address, so behind a
# proxy every client would share one rate limit: set this when you deploy
TRUSTED_PROXY_HOPS=0
# Requests per client IP per minute to API routes (/api/auth has its own limits), 0 for none
RATE_LIMIT_PER_MINUTE=300
# Migrations: applied on startup outside production. In production run `bun run db:migrate`
# once per release instead (GET /ready answers 503 until it has), or set this to true on a
# single instance that should migrate itself
# MIGRATE_ON_START=true
# On SIGTERM: how long /ready fails while new connections are still served, so load
# balancers move away first (default 0; a few seconds behind Kubernetes, ECS or Fly), then
# how long requests in flight get to finish. Together, keep them under the platform's grace
# period (docker stop: 10 s, Kubernetes: 30 s)
# SHUTDOWN_DELAY_MS=0
# SHUTDOWN_GRACE_MS=8000

# Sign in with GitHub: leave empty to turn it off
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mail: any SMTP server, as smtp://user:pass@host:587 or smtps://user:pass@host:465.
# Here it is Mailpit (docker-compose.yml), whose inbox is at MAILPIT_URL
SMTP_URL=smtp://localhost:3146
MAIL_FROM=no-reply@example.com
MAILPIT_URL=http://localhost:3145

# App
APP_PORT=3142
BUN_PUBLIC_API_URL=http://localhost:3141
