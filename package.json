{
  "name": "untitled-bun-app",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@hono/zod-openapi": "^1.6.3",
      "@types/bun": "^1.4.4",
      "hono": "^4.13.14",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "bun scripts/predev.ts && bun run --parallel --filter '@repo/*' dev",
    "lint:check": "bun lint --max-warnings 0",
    "fmt:check": "bun fmt --check",
    "typecheck": "bun check && bun check -p apps/api && bun check -p apps/app",
    "test": "bun test",
    "db:generate": "bun run --filter @repo/api db:generate",
    "db:migrate": "bun run --filter @repo/api db:migrate",
    "db:seed": "bun run --filter @repo/api db:seed"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  }
}
